# Rust build artifacts
/target/
/mutants.out*/
# Default MUTANTS_DIFF_FILE written by scripts/run-mutants.sh in diff/ci-pr mode.
/git.diff

# SonarQube Cloud scanner cache and local API reports
/.sonar/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Editor swap/backup files
*.swp
*.swo
*~

# Flatpak / Meson build artifacts
.flatpak-builder/
builddir/
_build/

# Generated validation and visual-proof artifacts. Keep build/smoke-local
# visible because it contains checked-in local smoke evidence fixtures.
/build/blueprint-validation/
/build/blueprint-visual-diff/
/build/gnome-50-ui-spikes/
/build/gtk-proof/
/build/live-run/
/build/gtk-lush-adoption/
/build/proof-corpus/
/build/smoke/
# Local-only formal-evaluation tools and run logs (scripts/formal-evaluation.sh).
/build/formal-evaluation/
# TLC run metadata when a model is checked from its own directory.
/formal/evaluation/**/states/

# Local agent worktree caches can contain full repo checkouts and smoke logs.
/.claude/worktrees/

# Stock adoption fixtures are committed, but their standalone Cargo artifacts are not.
/fixtures/gtk-lush-adoption/*/target/

# Compiled GSettings schemas (generated by build.rs)
data/gschemas.compiled

# Distro packages
*.rpm
*.deb

# Python cache artifacts
__pycache__/
*.py[cod]
