+// --- evaluate-verus-for-unbounded-proofs, task 3.1 (SCRATCH, never committed) ---
+//
+// One-step inductive attempt over the two-window lane scope: an arbitrary
+// state assumed to satisfy INV, one action, INV asserted after it; with a base
+// case (INV after the first startup) and a cover that INV is satisfiable.
+
+const STEP_IDS: usize = 2;
+const STEP_W: usize = 2;
+type StepJournal = Journal<TwoWindowScope, STEP_IDS, STEP_W, 1>;
+
+fn any_content_below(bound: ContentId) -> ContentId {
+    let c: ContentId = kani::any();
+    kani::assume(c < bound);
+    c
+}
+
+fn any_option_content(bound: ContentId) -> Option<ContentId> {
+    if kani::any() { Some(any_content_below(bound)) } else { None }
+}
+
+fn any_step(bound: ContentId) -> Option<DeletionStep> {
+    if kani::any() { Some(kani::any()) } else { None }
+}
+
+fn any_editor(bound: ContentId) -> Editor {
+    Editor {
+        open: kani::any(),
+        content: any_content_below(bound),
+        dirty: kani::any(),
+        token: kani::any(),
+        written: any_option_content(bound),
+        restore_pending: kani::any(),
+        deletion: any_step(bound),
+        preserve_queued: kani::any(),
+    }
+}
+
+fn any_lane_use() -> LaneUse {
+    match any_below(3) {
+        0 => LaneUse::Pass(any_below(STEP_IDS) as u8),
+        1 => LaneUse::Deletion(any_below(STEP_IDS) as u8),
+        _ => LaneUse::Cleanup,
+    }
+}
+
+fn any_window(id: u8, bound: ContentId) -> Window<STEP_IDS> {
+    Window {
+        id,
+        running: kani::any(),
+        editors: [any_editor(bound), any_editor(bound)],
+        known: [kani::any(), kani::any()],
+        trusted: kani::any(),
+        last_reconciliation_complete: kani::any(),
+        lane: None,
+        orphan_candidate: [any_option_content(bound), any_option_content(bound)],
+        missing_candidate: [kani::any(), kani::any()],
+    }
+}
+
+/// An arbitrary state of the two-window scope, within the model's domains.
+fn any_state() -> StepJournal {
+    let edits = any_below(MAX_EDITS + 1);
+    let next_content = (1 + STEP_IDS + edits) as ContentId;
+    let mut ancestors = [0 as ContentSet; CONTENTS];
+    for c in 0..CONTENTS {
+        ancestors[c] = kani::any();
+    }
+    StepJournal {
+        scope: core::marker::PhantomData,
+        processes: [Process {
+            windows: [any_window(0, next_content), any_window(1, next_content)],
+            lane: if kani::any() {
+                Some(LaneHolder { window: any_below(STEP_W) as u8, lane_use: any_lane_use() })
+            } else {
+                None
+            },
+            restored: kani::any(),
+            cleanup_owner: if kani::any() { Some(any_below(STEP_W) as u8) } else { None },
+        }],
+        entry: [
+            DiskEntry { present: kani::any(), backing: kani::any(), stamp: kani::any() },
+            DiskEntry { present: kani::any(), backing: kani::any(), stamp: kani::any() },
+        ],
+        body: [any_option_content(next_content), any_option_content(next_content)],
+        backing: [kani::any(), kani::any()],
+        preserved: kani::any(),
+        accepted: kani::any(),
+        resolved: kani::any(),
+        ancestors,
+        next_content,
+        edits,
+    }
+}
+
+impl<S: Scope, const IDS: usize, const W: usize, const P: usize> Journal<S, IDS, W, P> {
+    fn all_contents(&self) -> ContentSet {
+        let mut mask: ContentSet = 0;
+        for c in 1..usize::from(self.next_content) {
+            mask |= bit(c as ContentId);
+        }
+        mask
+    }
+
+    /// W0: the ghost content model is well formed.
+    fn contents_well_formed(&self) -> bool {
+        let all = self.all_contents();
+        let mut ok = self.ancestors[0] == 0
+            && self.preserved & !all == 0
+            && self.accepted & !all == 0
+            && self.resolved & !all == 0;
+        for c in 1..CONTENTS {
+            let a = self.ancestors[c];
+            if c >= usize::from(self.next_content) {
+                ok &= a == 0;
+            } else if c <= IDS {
+                ok &= a == bit(c as ContentId);
+            } else {
+                // An edit contains itself, only older contents, and is closed.
+                ok &= a & bit(c as ContentId) != 0 && a & !all == 0 && a >> (c + 1) == 0;
+                for d in 1..CONTENTS {
+                    if a & bit(d as ContentId) != 0 {
+                        ok &= self.ancestors[d] & !a == 0;
+                    }
+                }
+            }
+        }
+        ok
+    }
+
+    fn s1_holds(&self) -> bool {
+        let mut recoverable: ContentSet = 0;
+        for kept in 1..CONTENTS {
+            if self.preserved & bit(kept as ContentId) != 0 {
+                recoverable |= self.ancestors[kept];
+            }
+        }
+        for id in 0..IDS {
+            if let Some(body) = self.body[id] && body != 0 {
+                recoverable |= self.ancestors[usize::from(body)];
+            }
+        }
+        for process in 0..P {
+            for window in 0..W {
+                let window = &self.processes[process].windows[window];
+                if !window.running {
+                    continue;
+                }
+                for id in 0..IDS {
+                    let editor = window.editors[id];
+                    if editor.open && editor.content != 0 {
+                        recoverable |= self.ancestors[usize::from(editor.content)];
+                    }
+                }
+            }
+        }
+        self.accepted & !self.resolved & !recoverable == 0
+    }
+
+    fn s3_holds(&self) -> bool {
+        let mut ok = true;
+        for process in 0..P {
+            for window in 0..W {
+                let window = &self.processes[process].windows[window];
+                for id in 0..IDS {
+                    if window.editors[id].deletion.is_some() && !self.untitled(id) {
+                        ok &= !(self.body[id].is_some() && !self.entry[id].present);
+                    }
+                }
+            }
+        }
+        ok
+    }
+
+    fn s4_holds(&self) -> bool {
+        let mut ok = true;
+        for process in 0..P {
+            for window in 0..W {
+                let window = &self.processes[process].windows[window];
+                if window.running && window.trusted {
+                    ok &= window.last_reconciliation_complete && self.inventory_complete();
+                }
+            }
+        }
+        ok
+    }
+
+    fn single_owner_holds(&self) -> bool {
+        let mut ok = true;
+        for process in 0..P {
+            for id in 0..IDS {
+                let mut owners = 0;
+                for window in 0..W {
+                    let window = &self.processes[process].windows[window];
+                    if window.running && window.editors[id].open {
+                        owners += 1;
+                    }
+                }
+                ok &= owners <= 1;
+            }
+        }
+        ok
+    }
+
+    /// S1–S4 and one owning window per id: the lane harness's assertions.
+    fn backbone_holds(&self) -> bool {
+        self.s1_holds() && self.s3_holds() && self.s4_holds() && self.single_owner_holds()
+    }
+
+    fn strengthening_holds(&self) -> bool {
+        self.strengthening_mask() == 0
+    }
+
+    /// The strengthening conjuncts found in scratch, one bit per conjunct.
+    fn strengthening_mask(&self) -> u64 {
+        // The conjuncts are written for the two-window lane scope.
+        assert!(IDS == STEP_IDS && W == STEP_W && P == 1);
+        // STRENGTHENING-BEGIN
+        let process = &self.processes[0];
+        let mut ok = true;
+        let mut mask: u64 = 0;
+        // R1a: stopped windows and a stopped process are reset; closed
+        // editors of running windows are CLOSED.
+        let any_running = process.windows[0].running || process.windows[1].running;
+        if !any_running {
+            { let c = process.lane.is_none() && !process.restored && process.cleanup_owner.is_none(); ok &= c; if !c { mask |= 1u64 << 0; } }
+            // R3a: a stopped process's windows list nothing.
+            for w in 0..STEP_W {
+                for id in 0..STEP_IDS {
+                    { let c = process.windows[w].known[id].is_none(); ok &= c; if !c { mask |= 1u64 << 27; } }
+                }
+            }
+        } else {
+            // R1h: a running process already ran its one startup restore.
+            { let c = process.restored; ok &= c; if !c { mask |= 1u64 << 1; } }
+        }
+        for w in 0..STEP_W {
+            let win = &process.windows[w];
+            if !win.running {
+                { let c = !win.trusted && !win.last_reconciliation_complete; ok &= c; if !c { mask |= 1u64 << 2; } }
+                for id in 0..STEP_IDS {
+                    let e = win.editors[id];
+                    { let c = !e.open
+                        && win.orphan_candidate[id].is_none() && win.missing_candidate[id].is_none(); ok &= c; if !c { mask |= 1u64 << 3; } }
+                }
+            }
+            for id in 0..STEP_IDS {
+                let e = win.editors[id];
+                if !e.open {
+                    { let c = e.content == 0 && !e.dirty && !e.token && e.written.is_none()
+                        && !e.restore_pending && e.deletion.is_none() && !e.preserve_queued; ok &= c; if !c { mask |= 1u64 << 4; } }
+                }
+                // R1b: a deletion is never parked at a terminal step.
+                { let c = !matches!(e.deletion, Some(DeletionStep::Done | DeletionStep::Stopped)); ok &= c; if !c { mask |= 1u64 << 5; } }
+                // R1c: a token or a written body belongs to an open, dirty-able
+                // editor that holds the lane for its pass.
+                let holds_pass = process.lane
+                    == Some(LaneHolder { window: w as u8, lane_use: LaneUse::Pass(id as u8) });
+                if e.token || e.written.is_some() {
+                    { let c = win.running && e.open && holds_pass; ok &= c; if !c { mask |= 1u64 << 6; } }
+                }
+                if e.token {
+                    { let c = e.dirty && !e.restore_pending && e.deletion.is_none(); ok &= c; if !c { mask |= 1u64 << 7; } }
+                    // R1d: a token for a file-backed id has its entry.
+                    { let c = self.untitled(id) || self.entry[id].present; ok &= c; if !c { mask |= 1u64 << 8; } }
+                }
+                // R1e: a trusted window's manifest copy lists only entries on disk.
+                if win.running && win.trusted && win.known[id].is_some() {
+                    { let c = self.entry[id].present; ok &= c; if !c { mask |= 1u64 << 9; } }
+                }
+                // R1f: cleanup candidates exist only while this window holds the
+                // cleanup lane; an orphan candidate is the unlisted body.
+                let holds_cleanup = process.lane
+                    == Some(LaneHolder { window: w as u8, lane_use: LaneUse::Cleanup });
+                if win.orphan_candidate[id].is_some() || win.missing_candidate[id].is_some() {
+                    { let c = holds_cleanup; ok &= c; if !c { mask |= 1u64 << 10; } }
+                }
+                if let Some(c) = win.orphan_candidate[id] {
+                    { let c = self.body[id] == Some(c) && !self.entry[id].present; ok &= c; if !c { mask |= 1u64 << 11; } }
+                }
+            }
+        }
+        // R1g: the lane holder is a running window doing that work.
+        if let Some(h) = process.lane {
+            let w = usize::from(h.window);
+            let win = &process.windows[w];
+            { let c = win.running; ok &= c; if !c { mask |= 1u64 << 12; } }
+            match h.lane_use {
+                LaneUse::Pass(id) => {
+                    let e = win.editors[usize::from(id)];
+                    { let c = e.open && (e.token || e.written.is_some()); ok &= c; if !c { mask |= 1u64 << 13; } }
+                }
+                LaneUse::Deletion(id) => {
+                    let e = win.editors[usize::from(id)];
+                    { let c = e.open && e.deletion.is_some(); ok &= c; if !c { mask |= 1u64 << 14; } }
+                }
+                LaneUse::Cleanup => {
+                    { let c = win.trusted && process.cleanup_owner == Some(h.window); ok &= c; if !c { mask |= 1u64 << 15; } }
+                }
+            }
+        }
+        if let Some(owner) = process.cleanup_owner {
+            { let c = process.windows[usize::from(owner)].running; ok &= c; if !c { mask |= 1u64 << 16; } }
+        }
+        // ---- round 2 ----
+        let all = self.all_contents();
+        let mut pcl: ContentSet = 0;
+        for kept in 1..CONTENTS {
+            if self.preserved & bit(kept as ContentId) != 0 {
+                pcl |= self.ancestors[kept];
+            }
+        }
+        let mut disk = pcl;
+        for id in 0..STEP_IDS {
+            if let Some(c) = self.body[id] {
+                disk |= self.ancestors[usize::from(c)];
+            }
+        }
+        // R2s1: S1 holds from disk alone (preserved copies and bodies), so a
+        // crash or a window close loses nothing accepted.
+        { let c = self.accepted & !self.resolved & !disk == 0; ok &= c; if !c { mask |= 1u64 << 17; } }
+        // R2a: while the process runs, every file-backed body has its entry.
+        if any_running {
+            { let c = self.inventory_complete(); ok &= c; if !c { mask |= 1u64 << 18; } }
+        }
+        for id in 0..STEP_IDS {
+            // R2w: content 0 ("nothing to protect") is never a body, a written
+            // generation, or a cleanup candidate.
+            { let c = self.body[id] != Some(0); ok &= c; if !c { mask |= 1u64 << 19; } }
+            if let Some(c) = self.body[id] {
+                let unique = self.ancestors[usize::from(c)] & self.accepted & !self.resolved & !pcl;
+                // R2f: a body no entry lists holds no unresolved accepted work
+                // beyond the preserved copies.
+                if !self.entry[id].present {
+                    { let c = unique == 0; ok &= c; if !c { mask |= 1u64 << 20; } }
+                }
+                for w in 0..STEP_W {
+                    let win = &process.windows[w];
+                    let e = win.editors[id];
+                    if win.running && e.open {
+                        // R2b: the owning editor protects the body's unresolved
+                        // accepted work: it holds it, or the body is unseen, or
+                        // its deletion preserves first.
+                        { let c = e.restore_pending
+                            || e.deletion == Some(DeletionStep::Preserve)
+                            || unique & !self.ancestors[usize::from(e.content)] == 0; ok &= c; if !c { mask |= 1u64 << 21; } }
+                        // R2h: a deletion past its preserve step deletes nothing
+                        // unresolved.
+                        if matches!(e.deletion, Some(DeletionStep::DeleteBody | DeletionStep::RemoveEntry)) {
+                            { let c = unique == 0; ok &= c; if !c { mask |= 1u64 << 22; } }
+                        }
+                    }
+                }
+            }
+            for w in 0..STEP_W {
+                let win = &process.windows[w];
+                let e = win.editors[id];
+                { let c = win.orphan_candidate[id] != Some(0); ok &= c; if !c { mask |= 1u64 << 23; } }
+                if matches!(e.deletion, Some(DeletionStep::Preserve)) {
+                    { let c = e.preserve_queued; ok &= c; if !c { mask |= 1u64 << 24; } }
+                }
+                // R2d: a written generation is the body on disk, and the
+                // editor's buffer contains it.
+                if let Some(written) = e.written {
+                    { let c = written != 0
+                        && self.body[id] == Some(written)
+                        && self.ancestors[usize::from(e.content)] & bit(written) != 0; ok &= c; if !c { mask |= 1u64 << 25; } }
+                }
+                // R2c: a running window lists every entry on disk, except the
+                // id it is deleting.
+                let mut deleting = false;
+                for other in 0..STEP_W {
+                    deleting |= process.windows[other].running && process.windows[other].editors[id].deletion.is_some();
+                }
+                if win.running && self.entry[id].present && !deleting {
+                    { let c = win.known[id].is_some(); ok &= c; if !c { mask |= 1u64 << 26; } }
+                }
+            }
+        }
+        for w in 0..STEP_W {
+            let win = &process.windows[w];
+            for id in 0..STEP_IDS {
+                let e = win.editors[id];
+                // R3b: a token and a written body never coexist (F1).
+                if e.token {
+                    { let c = e.written.is_none(); ok &= c; if !c { mask |= 1u64 << 28; } }
+                }
+                // R3c: a dirty buffer holds an edit.
+                if e.dirty {
+                    { let c = e.content != 0; ok &= c; if !c { mask |= 1u64 << 29; } }
+                }
+                // R3d: an open editor whose id has no entry holds no unresolved
+                // accepted work beyond the preserved copies.
+                if win.running && e.open && !self.entry[id].present {
+                    { let c = self.ancestors[usize::from(e.content)] & self.accepted & !self.resolved & !pcl == 0; ok &= c; if !c { mask |= 1u64 << 30; } }
+                }
+            }
+        }
+        let _ = all;
+        let _ = ok;
+        mask
+        // STRENGTHENING-END
+    }
+
+    fn inductive_invariant(&self) -> bool {
+        self.contents_well_formed() && self.backbone_holds() && self.strengthening_holds()
+    }
+}
