+/// Diagnosis: which action breaks which conjunct (one cover per pair).
+#[kani::proof]
+#[kani::unwind(9)]
+fn verus_eval_diagnose() {
+    let mut journal = any_state();
+    kani::assume(journal.inductive_invariant());
+    let action: Action = kani::any();
+    let fault: bool = kani::any();
+    journal.step(0, any_below(2), action, any_below(2), fault);
+    let w0 = !journal.contents_well_formed();
+    let s1 = !journal.s1_holds();
+    let s3 = !journal.s3_holds();
+    let s4 = !journal.s4_holds();
+    let own = !journal.single_owner_holds();
+    let st = !journal.strengthening_holds();
+    let before = 0u64;
+    let after = journal.strengthening_mask();
+    kani::cover!(after & (1u64 << 0) != 0 && before == 0, "C0:R1a");
+    kani::cover!(after & (1u64 << 1) != 0 && before == 0, "C1:R1h");
+    kani::cover!(after & (1u64 << 2) != 0 && before == 0, "C2:R1h");
+    kani::cover!(after & (1u64 << 3) != 0 && before == 0, "C3:R1h");
+    kani::cover!(after & (1u64 << 4) != 0 && before == 0, "C4:R1h");
+    kani::cover!(after & (1u64 << 5) != 0 && before == 0, "C5:R1b");
+    kani::cover!(after & (1u64 << 6) != 0 && before == 0, "C6:R1c");
+    kani::cover!(after & (1u64 << 7) != 0 && before == 0, "C7:R1c");
+    kani::cover!(after & (1u64 << 8) != 0 && before == 0, "C8:R1d");
+    kani::cover!(after & (1u64 << 9) != 0 && before == 0, "C9:R1e");
+    kani::cover!(after & (1u64 << 10) != 0 && before == 0, "C10:R1f");
+    kani::cover!(after & (1u64 << 11) != 0 && before == 0, "C11:R1f");
+    kani::cover!(after & (1u64 << 12) != 0 && before == 0, "C12:R1g");
+    kani::cover!(after & (1u64 << 13) != 0 && before == 0, "C13:R1g");
+    kani::cover!(after & (1u64 << 14) != 0 && before == 0, "C14:R1g");
+    kani::cover!(after & (1u64 << 15) != 0 && before == 0, "C15:R1g");
+    kani::cover!(after & (1u64 << 16) != 0 && before == 0, "C16:R1g");
