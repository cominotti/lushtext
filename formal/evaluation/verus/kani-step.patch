+/// A ten-action trace the inductive step's counterexamples pointed at, in the
+/// lane's single-window scope (untitled id 2), from an empty previous session:
+/// a pass writes a body, registers again, fails its second write (which
+/// releases the lane while the first body still awaits its commit), orphan
+/// cleanup deletes that unlisted untitled body, the commit then accepts the
+/// deleted generation, and a crash loses the only copy (the editor buffer).
+#[kani::proof]
+#[kani::unwind(9)]
+fn verus_eval_trace_untitled_orphan() {
+    let mut journal = Journal::<SingleWindowScope, 3, 1, 1>::previous_session();
+    for id in 0..3 {
+        kani::assume(!journal.entry[id].present && journal.body[id].is_none() && journal.backing[id] == 0);
+    }
+    let trace = [
+        (Action::Startup, 0, false),
+        (Action::Open, 2, false),
+        (Action::Edit, 2, false),
+        (Action::Register, 2, false),
+        (Action::WriteBody, 2, false),
+        (Action::Register, 2, false),
+        (Action::WriteBody, 2, true),
+        (Action::Inspect, 2, false),
+        (Action::ExecCleanup, 2, false),
+        (Action::Commit, 2, false),
+        (Action::Crash, 0, false),
+    ];
+    for (action, id, fault) in trace {
+        journal.step(0, 0, action, id, fault);
+        journal.assert_invariants();
+    }
+}
