+/// Base case: INV holds after the first startup (as the lane harnesses start).
+#[kani::proof]
+#[kani::unwind(9)]
+fn verus_eval_base_case() {
+    let mut journal = StepJournal::previous_session();
+    journal.step(0, 0, Action::Startup, 0, kani::any());
+    assert!(journal.inductive_invariant(), "base case: INV after the first startup");
+}
+
+/// Satisfiability: some state satisfies the assumed INV (a non-trivial one: a
+/// running window with an open dirty editor and an accepted content).
+#[kani::proof]
+#[kani::unwind(9)]
+fn verus_eval_invariant_is_satisfiable() {
+    let journal = any_state();
+    kani::assume(journal.inductive_invariant());
+    kani::cover!(
+        journal.processes[0].windows[0].running
+            && journal.processes[0].windows[0].editors[0].open
+            && journal.processes[0].windows[0].editors[0].dirty
+            && journal.accepted != 0,
+        "a non-trivial state satisfies INV"
+    );
+}
