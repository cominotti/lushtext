[Desktop Entry]
Name=LushText
Comment=A minimalist text editor with workspaces, Markdown preview, and notes
Exec=lushtext %U
Icon=dev.cominotti.lushtext
Terminal=false
Type=Application
Categories=TextEditor;Utility;GTK;GNOME;
Keywords=Text;Editor;Code;Markdown;Workspace;Notes;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-python;application/json;text/markdown;text/x-rust;
StartupNotify=true
X-Purism-FormFactor=workstation;
