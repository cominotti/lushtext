<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>

  <template class="LushtextSidebar" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width-request">200</property>

    <style>
      <class name="sidebar"/>
    </style>

    <child>
      <object class="GtkBox" id="new_workspace_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">54</property>
        <property name="spacing">6</property>
        <property name="margin-start">12</property>
        <property name="margin-end">6</property>

        <child>
          <object class="GtkLabel" id="new_workspace_label">
            <property name="label">New Workspace</property>
            <property name="hexpand">true</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="new_workspace_button">
            <property name="icon-name">folder-new-symbolic</property>
            <property name="tooltip-text" translatable="yes">New Workspace</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <!-- Scrollable area for all workspace sections -->
    <child>
      <object class="GtkScrolledWindow" id="outer_scrolled_window">
        <property name="vexpand">true</property>
        <property name="propagate-natural-width">true</property>
        <property name="hscrollbar-policy">automatic</property>
        <child>
          <object class="GtkBox" id="sections_box">
            <property name="orientation">vertical</property>
            <!-- Workspace sections appended programmatically -->
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
