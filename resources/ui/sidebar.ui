<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>

  <template class="LushtextSidebar" parent="GtkBox">
    <property name="orientation">vertical</property>

    <style>
      <class name="sidebar"/>
    </style>

    <child>
      <object class="GtkBox" id="new_workspace_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">54</property>
        <property name="spacing">6</property>
        <!-- Match the left inset of navigation-sidebar top-level rows so the selector
             aligns with the workspace tree chrome instead of the section headers. -->
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>

        <child>
          <object class="GtkDropDown" id="workspace_filter_dropdown">
            <property name="hexpand">true</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="new_workspace_button">
            <property name="icon-name">folder-new-symbolic</property>
            <property name="tooltip-text" translatable="yes">New Workspace</property>
            <!-- Keep the hover pill inside the fixed selector row instead of bleeding
                 past the drop-down's top or bottom bounds. -->
            <property name="valign">center</property>
            <property name="margin-top">6</property>
            <property name="margin-bottom">6</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <child>
      <object class="GtkRevealer" id="workspace_list_revealer">
        <property name="reveal-child">true</property>
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">250</property>
        <child>
          <!-- Scrollable area for all workspace sections -->
          <object class="GtkScrolledWindow" id="outer_scrolled_window">
            <property name="vexpand">true</property>
            <property name="propagate-natural-width">false</property>
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="GtkBox" id="sections_box">
                <property name="orientation">vertical</property>
                <!-- Workspace sections appended programmatically -->
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
