<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>

  <template class="LushtextSidebar" parent="GtkBox">
    <property name="orientation">vertical</property>

    <style>
      <class name="sidebar"/>
    </style>

    <child>
      <object class="GtkBox" id="new_workspace_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">54</property>
        <property name="spacing">6</property>
        <property name="margin-start">12</property>
        <property name="margin-end">6</property>

        <child>
          <object class="GtkDropDown" id="workspace_filter_dropdown">
            <property name="hexpand">true</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="new_workspace_button">
            <property name="icon-name">folder-new-symbolic</property>
            <property name="tooltip-text" translatable="yes">New Workspace</property>
            <!-- Keep the hover pill inside the fixed selector row instead of bleeding
                 past the drop-down's top or bottom bounds. -->
            <property name="valign">center</property>
            <property name="margin-top">6</property>
            <property name="margin-bottom">6</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <child>
      <object class="GtkRevealer" id="workspace_list_revealer">
        <property name="reveal-child">true</property>
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">250</property>
        <child>
          <!-- Scrollable area for all workspace sections -->
          <object class="GtkScrolledWindow" id="outer_scrolled_window">
            <property name="vexpand">true</property>
            <property name="propagate-natural-width">false</property>
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="GtkBox" id="sections_box">
                <property name="orientation">vertical</property>
                <!-- Workspace sections appended programmatically -->
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkSeparator"/>
    </child>

    <child>
      <object class="GtkBox" id="workspace_size_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">54</property>
        <property name="hexpand">true</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>

        <child>
          <object class="GtkBox" id="workspace_size_buttons_box">
            <property name="spacing">0</property>
            <property name="hexpand">true</property>
            <property name="halign">center</property>
            <property name="valign">center</property>

            <style>
              <class name="linked"/>
            </style>

            <child>
              <object class="GtkToggleButton" id="small_width_button">
                <property name="label" translatable="yes">Small</property>
                <property name="tooltip-text" translatable="yes">Use 20% of the app window width for the workspace sidebar</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="comfy_width_button">
                <property name="label" translatable="yes">Comfy</property>
                <property name="tooltip-text" translatable="yes">Use 30% of the app window width for the workspace sidebar</property>
              </object>
            </child>

            <child>
              <object class="GtkToggleButton" id="large_width_button">
                <property name="label" translatable="yes">Large</property>
                <property name="tooltip-text" translatable="yes">Use 40% of the app window width for the workspace sidebar</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
