using Gtk 4.0;

template $LushtextWorkspaceSection: Box {
  orientation: vertical;
  // Top separator between workspace sections.
  Separator {}

  // Workspace header.
  Box header_box {
    orientation: horizontal;
    height-request: 54;
    spacing: 6;
    margin-start: 12;
    margin-end: 6;

    Button collapse_button {
      icon-name: "pan-down-symbolic";
      tooltip-text: _("Collapse Workspace");
      valign: center;
      margin-top: 6;
      margin-bottom: 6;

      styles [
        "flat",
        "circular",
      ]
    }

    Label header_label {
      label: _("New Workspace");
      hexpand: true;
      xalign: 0;

      styles [
        "heading",
      ]
    }

    Button add_folder_button {
      icon-name: "folder-new-symbolic";
      tooltip-text: _("Add Folder");
      valign: center;
      margin-top: 6;
      margin-bottom: 6;

      styles [
        "flat",
      ]
    }

    Button refresh_button {
      icon-name: "view-refresh-symbolic";
      tooltip-text: _("Refresh Workspace Folders");
      valign: center;
      margin-top: 6;
      margin-bottom: 6;

      styles [
        "flat",
      ]
    }
  }

  // Drilldown header, hidden until a focused folder is active.
  Box drilldown_header_box {
    orientation: horizontal;
    height-request: 40;
    spacing: 6;
    margin-start: 6;
    margin-end: 6;
    visible: false;

    Button drilldown_back_button {
      icon-name: "go-previous-symbolic";
      tooltip-text: _("Back to Parent");

      styles [
        "flat",
      ]
    }

    Label drilldown_path_label {
      hexpand: true;
      xalign: 0;
      ellipsize: middle;

      styles [
        "dim-label",
      ]
    }
  }

  // The slice bin owns the list view's adjustments: it reports the full tree
  // height to the outer sidebar scroller but allocates only the visible band,
  // so GtkListView stays virtualized (it realizes at most ~200 row widgets per
  // visible range) and its width follows the sidebar, not the deepest row.
  $GtkLushViewportSliceBin file_tree_slice {
    child: ListView file_tree_view {
      styles [
        "navigation-sidebar",
      ]
    };
  }

  Label empty_folder_set_label {
    label: _("No folders in this workspace");
    visible: false;
    wrap: true;
    xalign: 0;
    margin-start: 18;
    margin-end: 18;
    margin-top: 10;
    margin-bottom: 12;

    styles [
      "dim-label",
    ]
  }
}
