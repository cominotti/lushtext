<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>

  <template class="LushtextMarkdownPreview" parent="GtkBox">
    <property name="orientation">vertical</property>

    <child>
      <object class="GtkScrolledWindow" id="scrolled_window">
        <property name="vexpand">true</property>
        <property name="hexpand">true</property>
        <child>
          <object class="GtkTextView" id="text_view">
            <property name="editable">false</property>
            <property name="cursor-visible">false</property>
            <property name="wrap-mode">word</property>
            <property name="left-margin">16</property>
            <property name="right-margin">16</property>
            <property name="top-margin">12</property>
            <property name="bottom-margin">12</property>
            <style>
              <class name="tab-content-preview-surface"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <!-- Placeholder shown when active file is not Markdown -->
    <child>
      <object class="AdwStatusPage" id="placeholder">
        <property name="visible">false</property>
        <property name="vexpand">true</property>
        <property name="icon-name">document-page-setup-symbolic</property>
        <property name="title" translatable="yes">Markdown Preview</property>
        <property name="description" translatable="yes">Open a Markdown file to see a rendered preview</property>
        <style>
          <class name="preview-placeholder-opaque"/>
        </style>
      </object>
    </child>
  </template>
</interface>
