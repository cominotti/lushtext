using Gtk 4.0;

template $LushtextEditorPage: Box {
  orientation: vertical;
  vexpand: true;

  $LushtextInfoBar info_bar {}

  Overlay overlay {
    vexpand: true;

    child: Box editor_body {
      orientation: horizontal;
      hexpand: true;
      vexpand: true;

      ScrolledWindow scrolled_window {
        vexpand: true;
        hexpand: true;

        child: $GtkSourceView source_view {
          auto-indent: "true";
          smart-backspace: "true";
          // LushText applies editor font settings through the surface class
          // below. Keeping GtkTextView's built-in monospace mode disabled
          // avoids active-line top-ink clipping with GTK 4.22/GtkSourceView
          // 5.20 while preserving the user's selected monospace family.
          monospace: "false";
          top-margin: "6";
          bottom-margin: "6";
          left-margin: "12";
          right-margin: "12";

          styles [
            "tab-content-editor-surface",
          ]
        };
      }

      Overlay minimap_overlay {
        visible: false;
        hexpand: false;
        vexpand: true;
      }
    };
  }

  Revealer search_revealer {
    reveal-child: false;
    transition-type: slide_up;

    child: Box {
      orientation: vertical;

      Separator {}

      $LushtextSearchBar search_bar {}
    };
  }
}
