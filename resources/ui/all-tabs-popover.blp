using Gtk 4.0;

template $LushtextAllTabsPopover: Popover {
  accessible-role: dialog;

  accessibility {
    label: _("All Tabs");
    description: _("Search and pick one of the window's open tabs");
  }

  styles [
    "all-tabs-popover",
  ]

  child: Box {
    orientation: vertical;

    SearchEntry search_entry {
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 6;
      margin-end: 6;
      placeholder-text: _("Search open tabs");
    }

    Separator {
      orientation: horizontal;
    }

    Stack stack {
      vhomogeneous: false;
      hhomogeneous: false;

      Box empty_state {
        orientation: vertical;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        Label empty_title {
          label: _("No Open Tab Matches");
          wrap: true;
          justify: center;

          styles [
            "dim-label",
          ]
        }
      }

      ScrolledWindow list_scroller {
        hexpand: true;
        vexpand: true;
        min-content-width: 320;
        max-content-width: 320;
        max-content-height: 420;
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;
        propagate-natural-width: false;

        child: ListView list_view {
          single-click-activate: true;

          styles [
            "navigation-sidebar",
          ]
        };
      }
    }
  };
}
