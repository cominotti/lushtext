<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>

  <template class="LushtextWorkspaceSection" parent="GtkBox">
    <property name="orientation">vertical</property>

    <!-- Top separator between workspace sections -->
    <child>
      <object class="GtkSeparator"/>
    </child>

    <!-- Workspace header -->
    <child>
      <object class="GtkBox" id="header_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">54</property>
        <property name="spacing">6</property>
        <property name="margin-start">12</property>
        <property name="margin-end">6</property>

        <child>
          <object class="GtkLabel" id="header_label">
            <property name="label">New Workspace</property>
            <property name="hexpand">true</property>
            <property name="xalign">0</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="refresh_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text" translatable="yes">Refresh Workspace</property>
            <property name="sensitive">false</property>
            <property name="valign">center</property>
            <property name="margin-top">6</property>
            <property name="margin-bottom">6</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="add_folder_button">
            <property name="icon-name">folder-new-symbolic</property>
            <property name="tooltip-text" translatable="yes">Add Folder to Workspace</property>
            <!-- Keep the hover pill inside the header row with matching top/bottom breathing room
                 instead of pushing the file tree farther away below. -->
            <property name="valign">center</property>
            <property name="margin-top">6</property>
            <property name="margin-bottom">6</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <!-- Drilldown header (hidden by default) -->
    <child>
      <object class="GtkBox" id="drilldown_header_box">
        <property name="orientation">horizontal</property>
        <property name="height-request">40</property>
        <property name="spacing">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <property name="visible">false</property>

        <child>
          <object class="GtkButton" id="drilldown_back_button">
            <property name="icon-name">go-previous-symbolic</property>
            <property name="tooltip-text" translatable="yes">Back to Parent</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="drilldown_path_label">
            <property name="hexpand">true</property>
            <property name="xalign">0</property>
            <property name="ellipsize">middle</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
      </object>
    </child>

    <!-- File tree in inner ScrolledWindow (provides vadjustment for ListView) -->
    <child>
      <object class="GtkScrolledWindow" id="inner_scrolled_window">
        <property name="propagate-natural-height">true</property>
        <property name="propagate-natural-width">false</property>
        <property name="vscrollbar-policy">never</property>
        <property name="hscrollbar-policy">never</property>
        <child>
          <object class="GtkListView" id="file_tree_view">
            <style>
              <class name="navigation-sidebar"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
