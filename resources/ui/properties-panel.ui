<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="libadwaita" version="1.6"/>

  <template class="LushtextPropertiesPanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width-request">280</property>

    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <property name="hscrollbar-policy">never</property>
        <property name="propagate-natural-height">true</property>
        <property name="min-content-height">260</property>
        <property name="max-content-height">420</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="spacing">12</property>

            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Document</property>

                <child>
                  <object class="AdwActionRow" id="location_row">
                    <property name="title" translatable="yes">Location</property>
                    <property name="subtitle" translatable="yes">No document selected</property>
                    <property name="subtitle-lines">3</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="file_size_row">
                    <property name="title" translatable="yes">File Size</property>
                    <property name="subtitle" translatable="yes">Not available</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="statistics_row">
                    <property name="title" translatable="yes">Statistics</property>
                    <property name="subtitle" translatable="yes">Open a document to inspect statistics</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="formatting_source_row">
                    <property name="title" translatable="yes">Formatting Source</property>
                    <property name="subtitle" translatable="yes">Not available</property>
                    <property name="subtitle-lines">2</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup" id="health_group">
                <property name="title" translatable="yes">Health</property>

                <child>
                  <object class="AdwActionRow" id="health_summary_row">
                    <property name="title" translatable="yes">File Health</property>
                    <property name="subtitle" translatable="yes">Open a document to inspect file health</property>
                    <property name="subtitle-lines">3</property>
                    <child type="suffix">
                      <object class="GtkButton" id="health_review_button">
                        <property name="label" translatable="yes">Review…</property>
                        <property name="action-name">win.show-file-health</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
