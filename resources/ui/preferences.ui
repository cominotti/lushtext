<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="libadwaita" version="1.6"/>

  <template class="LushtextPreferences" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Editor</property>
        <property name="icon-name">document-edit-symbolic</property>

        <!-- Appearance group -->
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Appearance</property>

            <child>
              <object class="AdwComboRow" id="style_scheme_row">
                <property name="title" translatable="yes">Color Scheme</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="use_system_font_row">
                <property name="title" translatable="yes">Use System Monospace Font</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="custom_font_row">
                <property name="title" translatable="yes">Custom Font</property>
                <property name="sensitive">false</property>
                <child type="suffix">
                  <object class="GtkFontDialogButton" id="font_button">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="transparency_row">
                <property name="title" translatable="yes">Transparency</property>
                <property name="subtitle" translatable="yes">Adjust the opacity of editor and Markdown preview backgrounds</property>
                <property name="activatable-widget">transparency_button</property>
                <child type="suffix">
                  <object class="GtkMenuButton" id="transparency_button">
                    <style>
                      <class name="flat"/>
                    </style>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkLabel" id="transparency_label">
                            <property name="width-chars">6</property>
                            <property name="max-width-chars">6</property>
                            <attributes>
                              <attribute name="font-features" value="'tnum'"/>
                            </attributes>
                          </object>
                        </child>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">pan-down-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <property name="popover">
                      <object class="GtkPopover">
                        <child>
                          <object class="GtkScale" id="transparency_scale">
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment" id="transparency_adjustment">
                                <property name="lower">0</property>
                                <property name="upper">1</property>
                                <property name="step-increment">0.05</property>
                                <property name="page-increment">0.25</property>
                                <property name="value">1.0</property>
                              </object>
                            </property>
                            <marks>
                              <mark value="0.25"/>
                              <mark value="0.5"/>
                              <mark value="0.75"/>
                            </marks>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Focus Mode</property>

            <child>
              <object class="AdwSpinRow" id="focus_mode_target_columns_row">
                <property name="title" translatable="yes">Column Width</property>
                <property name="subtitle" translatable="yes">Target readable column width while focused</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">60</property>
                    <property name="upper">120</property>
                    <property name="step-increment">5</property>
                    <property name="page-increment">10</property>
                    <property name="value">80</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="focus_mode_typewriter_scrolling_row">
                <property name="title" translatable="yes">Typewriter Scrolling</property>
                <property name="subtitle" translatable="yes">Keep the cursor near the center while editing in Focus Mode</property>
                <property name="active">false</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Minimap group -->
        <child>
          <object class="AdwPreferencesGroup" id="minimap_group">
            <property name="title" translatable="yes">Minimap</property>

            <child>
              <object class="AdwSwitchRow" id="show_minimap_row">
                <property name="title" translatable="yes">Show Minimap</property>
                <property name="subtitle" translatable="yes">Display a document overview on supported editor pages</property>
                <property name="active">false</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="minimap_long_line_markers_row">
                <property name="title" translatable="yes">Show Long-Line Markers</property>
                <property name="subtitle" translatable="yes">Opt in to marking lines over the minimap warning threshold</property>
                <property name="active">false</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Behavior group -->
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Behavior</property>

            <child>
              <object class="AdwSwitchRow" id="editorconfig_row">
                <property name="title" translatable="yes">Use EditorConfig</property>
                <property name="subtitle" translatable="yes">Apply .editorconfig files for per-file formatting</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="word_wrap_row">
                <property name="title" translatable="yes">Word Wrap</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSpinRow" id="tab_width_row">
                <property name="title" translatable="yes">Tab Width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">12</property>
                    <property name="step-increment">1</property>
                    <property name="value">4</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="insert_spaces_row">
                <property name="title" translatable="yes">Insert Spaces Instead of Tabs</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="show_line_numbers_row">
                <property name="title" translatable="yes">Show Line Numbers</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="highlight_line_row">
                <property name="title" translatable="yes">Highlight Current Line</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="bookmark_gutter_row">
                <property name="title" translatable="yes">Show Bookmark Gutter</property>
                <property name="subtitle" translatable="yes">Display bookmark indicators in the editor gutter</property>
                <property name="active">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Workspace</property>
        <property name="icon-name">folder-open-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Sidebar</property>

            <child>
              <object class="AdwComboRow" id="workspace_sidebar_width_row">
                <property name="title" translatable="yes">Sidebar Width</property>
                <property name="subtitle" translatable="yes">Choose how wide the workspace sidebar feels on desktop windows</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Navigation</property>

            <child>
              <object class="AdwSwitchRow" id="workspace_auto_collapse_row">
                <property name="title" translatable="yes">Auto-Collapse Workspaces</property>
                <property name="subtitle" translatable="yes">Collapse other workspaces when focusing a folder</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSpinRow" id="workspace_empty_folder_lookahead_cap_row">
                <property name="title" translatable="yes">Empty Folder Lookahead Cap</property>
                <property name="subtitle" translatable="yes">Maximum subdirectories to check for emptiness per scan</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">100</property>
                    <property name="upper">10000</property>
                    <property name="step-increment">100</property>
                    <property name="value">1000</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
