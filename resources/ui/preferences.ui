<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="libadwaita" version="1.6"/>

  <template class="LushtextPreferences" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Editor</property>
        <property name="icon-name">document-edit-symbolic</property>

        <!-- Appearance group -->
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Appearance</property>

            <child>
              <object class="AdwComboRow" id="style_scheme_row">
                <property name="title" translatable="yes">Color Scheme</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="use_system_font_row">
                <property name="title" translatable="yes">Use System Monospace Font</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="custom_font_row">
                <property name="title" translatable="yes">Custom Font</property>
                <property name="sensitive">false</property>
                <child type="suffix">
                  <object class="GtkFontDialogButton" id="font_button">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Behavior group -->
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Behavior</property>

            <child>
              <object class="AdwSwitchRow" id="editorconfig_row">
                <property name="title" translatable="yes">Use EditorConfig</property>
                <property name="subtitle" translatable="yes">Apply .editorconfig files for per-file formatting</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="word_wrap_row">
                <property name="title" translatable="yes">Word Wrap</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSpinRow" id="tab_width_row">
                <property name="title" translatable="yes">Tab Width</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">12</property>
                    <property name="step-increment">1</property>
                    <property name="value">4</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="insert_spaces_row">
                <property name="title" translatable="yes">Insert Spaces Instead of Tabs</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="show_line_numbers_row">
                <property name="title" translatable="yes">Show Line Numbers</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="highlight_line_row">
                <property name="title" translatable="yes">Highlight Current Line</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="show_minimap_row">
                <property name="title" translatable="yes">Show Minimap</property>
                <property name="subtitle" translatable="yes">Display a document overview on supported editor pages</property>
                <property name="active">false</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="bookmark_gutter_row">
                <property name="title" translatable="yes">Show Bookmark Gutter</property>
                <property name="subtitle" translatable="yes">Display bookmark indicators in the editor gutter</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSwitchRow" id="annotation_highlights_row">
                <property name="title" translatable="yes">Show Annotation Highlights</property>
                <property name="subtitle" translatable="yes">Highlight annotated line ranges in the editor</property>
                <property name="active">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Workspace</property>
        <property name="icon-name">folder-open-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Sidebar</property>

            <child>
              <object class="AdwComboRow" id="workspace_sidebar_width_row">
                <property name="title" translatable="yes">Sidebar Width</property>
                <property name="subtitle" translatable="yes">Choose how wide the workspace sidebar feels on desktop windows</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Navigation</property>

            <child>
              <object class="AdwSwitchRow" id="workspace_auto_collapse_row">
                <property name="title" translatable="yes">Auto-Collapse Workspaces</property>
                <property name="subtitle" translatable="yes">Collapse other workspaces when focusing a folder</property>
                <property name="active">true</property>
              </object>
            </child>

            <child>
              <object class="AdwSpinRow" id="workspace_empty_folder_lookahead_cap_row">
                <property name="title" translatable="yes">Empty Folder Lookahead Cap</property>
                <property name="subtitle" translatable="yes">Maximum subdirectories to check for emptiness per scan</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">100</property>
                    <property name="upper">10000</property>
                    <property name="step-increment">100</property>
                    <property name="value">1000</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
